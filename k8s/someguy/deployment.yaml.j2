{#
  Rendered by roles/kustomize_apply from someguy_all_instances
  (roles/someguy/defaults/main.yml): instance a, the first entry in that table.
  Instances b onward are k8s/someguy/deployment-extra.yaml.j2, which is
  deliberately mechanical and points back here for the reasoning.

  Only the name and the two ports come from the table. Everything else is
  written out below with its explanation, because it is the same for every
  instance and this is where it is explained.
#}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ someguy_first_instance.name }}
spec:
  replicas: 1
  # hostNetwork binds ports 8190 and 4004 on the node itself, so a second pod
  # cannot start while the old one holds them. A rolling update would deadlock;
  # Recreate stops the old pod first.
  #
  # A restart of THIS instance is no longer an outage for the box: Envoy fans
  # out across all four, health-checks them, and ejects one that stops
  # answering (verified: with an instance scaled to zero, 40/40 requests still
  # returned 200). roles/someguy rolls them one at a time, so a rollout costs
  # a quarter of the box's capacity rather than all of it. That matters
  # because responses are not cached (cf-cache-status: DYNAMIC), so someguy's
  # stale-if-error header has no effect.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ someguy_first_instance.name }}
  template:
    metadata:
      labels:
        app: {{ someguy_first_instance.name }}
    spec:
      # libp2p has no announce-address option and advertises the addresses it
      # sees on its interfaces. On the pod network those would be unreachable
      # 10.42.x addresses; on the host network they include the public IP.
      hostNetwork: true
      # The host's resolvers, deliberately not cluster DNS. someguy only needs
      # public names (autoconf, cid.contact, /dnsaddr). With hostNetwork,
      # ClusterFirst would also fall back to the host resolvers; Default states
      # that intent explicitly (ClusterFirstWithHostNet would opt in to
      # cluster DNS).
      dnsPolicy: Default

      # someguy shuts its HTTP server down within 5s of SIGTERM, then writes the
      # address book snapshot (sub-second at 25k peers) and closes the DHT. 30s
      # covers all three; SIGKILL mid-write leaves the previous snapshot intact
      # because the write is temp file plus rename.
      terminationGracePeriodSeconds: 30

      securityContext:
        runAsNonRoot: true
        # A uid with no account on the host. The image's own `ipfs` user is uid
        # 1000, which on these hosts is the provider's `ubuntu` login account
        # (in sudo and adm): with hostNetwork and no user namespace, an escape
        # would have landed as that user. Verified the image runs as 10001: its
        # binaries are world-executable and it only writes to the volume
        # below, which fsGroup makes writable.
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault

      containers:
        - name: someguy
          image: someguy
          envFrom:
            - configMapRef:
                name: someguy-env-vars
          # The only per-instance settings: which ports this one owns. Set here
          # rather than in a per-instance ConfigMap so the generated-ConfigMap
          # prune in roles/kustomize_apply still sees every ConfigMap in use.
          # someguy keeps no identity on disk, so each instance also gets its
          # own PeerID at start - the point of running more than one.
          env:
            - name: SOMEGUY_LISTEN_ADDRESS
              value: 127.0.0.1:{{ someguy_first_instance.api }}
            - name: SOMEGUY_LIBP2P_LISTEN_ADDRS
              value: /ip4/0.0.0.0/tcp/{{ someguy_first_instance.libp2p }},/ip4/0.0.0.0/udp/{{ someguy_first_instance.libp2p }}/quic-v1,/ip4/0.0.0.0/udp/{{ someguy_first_instance.libp2p }}/webrtc-direct,/ip4/0.0.0.0/udp/{{ someguy_first_instance.libp2p }}/quic-v1/webtransport,/ip6/::/tcp/{{ someguy_first_instance.libp2p }},/ip6/::/udp/{{ someguy_first_instance.libp2p }}/quic-v1,/ip6/::/udp/{{ someguy_first_instance.libp2p }}/webrtc-direct,/ip6/::/udp/{{ someguy_first_instance.libp2p }}/quic-v1/webtransport
          ports:
            - name: http
              containerPort: {{ someguy_first_instance.api }}
              protocol: TCP
            # 4004 is someguy's built-in libp2p default; roles/someguy opens the
            # same port in ufw. Change both together.
            - name: libp2p-tcp
              containerPort: {{ someguy_first_instance.libp2p }}
              protocol: TCP
            - name: libp2p-udp
              containerPort: {{ someguy_first_instance.libp2p }}
              protocol: UDP

          # One of FOUR instances per box (see kustomization.yaml). Together
          # they request 24 CPU and 80 GiB - the same ~70% of a 32-core /
          # 123 GiB box the single instance reserved, split four ways. The rest
          # is held for the bootstrapper, the content cluster node and the OS.
          #
          # 6 CPU is a floor, not a cap: measured 2026-09-16, four instances
          # serving 894 req/s used 4.4-4.9 cores each (18.2 of 32) and
          # 1.2-1.5 GiB each (5.5 GiB of 123). Memory stays hugely
          # over-reserved; the CPU floor covers the measured peak.
          #
          # No CPU limit on purpose: CFS throttling adds latency on a
          # latency-sensitive routing API, and the CPU request already
          # guarantees this pod its share.
          resources:
            requests:
              cpu: "6"
              memory: 20Gi
            limits:
              memory: 21Gi

          # someguy has no health endpoint. /version answers as soon as the
          # HTTP server is up, and the server keeps answering while the
          # accelerated DHT crawls (lookups fall back to the standard client).
          # host: 127.0.0.1 - the API only listens on loopback, and with
          # hostNetwork the kubelet's loopback is the same one.
          readinessProbe:
            httpGet:
              host: 127.0.0.1
              path: /version
              port: http
            initialDelaySeconds: 3
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            httpGet:
              host: 127.0.0.1
              path: /version
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 5
            failureThreshold: 6

          # No preStop pause. Nothing stops sending traffic during one - there
          # is no Service, and Envoy keeps using loopback - so it would only
          # lengthen every rollout without cutting errors.

          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]

          volumeMounts:
            - name: data
              mountPath: /data/someguy

      volumes:
        # The autoconf cache and the address book snapshot survive on this
        # volume; the identity and the DHT routing table do not - they stay in
        # memory and are rebuilt at start. Rendered per instance in
        # pvc.yaml.j2, one claim per running instance.
        - name: data
          persistentVolumeClaim:
            claimName: {{ someguy_first_instance.name }}-data
