---
# Envoy terminating TLS for the content node's read-only kubo gateway, the
# origin behind the dist.ipfs.tech Worker: https://{{ content_gateway_hostname }}:{{ content_gateway_port }}.
#
# client -> :{{ content_gateway_port }} TLS (Let's Encrypt, cert-manager) -> 127.0.0.1:{{ content_gateway_kubo_port }} plain HTTP (kubo gateway)
#
# Only GET and HEAD under /ipfs/ get through; everything else (/ipns/, /api,
# POST) is refused here, and kubo's RPC API is not on this port at all. kubo runs the
# gateway with NoFetch, so it serves blocks this node already holds and never
# fetches for a stranger. Range requests pass through untouched.

admin:
  # Host loopback only (hostNetwork).
  address:
    socket_address: { address: 127.0.0.1, port_value: {{ content_gateway_admin_port }} }

# SDS needs a node id and cluster, even for file-based sources.
node: { id: content-gateway, cluster: content-gateway }

overload_manager:
  resource_monitors:
    - name: envoy.resource_monitors.global_downstream_max_connections
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.resource_monitors.downstream_connections.v3.DownstreamConnectionsConfig
        max_active_downstream_connections: 1000

static_resources:
  listeners:
    - name: gw_https
      address:
        socket_address: { address: 0.0.0.0, port_value: {{ content_gateway_port }} }
      additional_addresses:
        - address:
            socket_address: { address: "::", port_value: {{ content_gateway_port }} }
      filter_chains:
        - transport_socket_connect_timeout: 10s
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                alpn_protocols: ["http/1.1"]
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                # File-based SDS: renewals are picked up without a restart.
                tls_certificate_sds_secret_configs:
                  - name: gw_cert
                    sds_config:
                      resource_api_version: V3
                      path_config_source:
                        path: /etc/envoy/config/sds.yaml
                        watched_directory: { path: /etc/envoy/config }
          filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: gw_https
                codec_type: HTTP1
                request_headers_timeout: 10s
                # A tarball download can sit idle between reads on a slow
                # client; the route timeout is off so large files finish.
                stream_idle_timeout: 300s
                common_http_protocol_options: { idle_timeout: 300s, max_headers_count: 50 }
                max_request_headers_kb: 16
                route_config:
                  name: gateway
                  virtual_hosts:
                    - name: gateway
                      domains: ["*"]
                      routes:
                        - match:
                            path: /__gateway/health
                          direct_response: { status: 200, body: { inline_string: "ok\n" } }
                        - match:
                            prefix: /ipfs/
                            headers: [{ name: ":method", string_match: { safe_regex: { regex: "GET|HEAD" } } }]
                          route: { cluster: kubo_gateway, timeout: 0s }
                        - match: { prefix: / }
                          direct_response:
                            status: 403
                            body:
                              inline_string: "this origin serves GET and HEAD under /ipfs/ only.\n"
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                      log_format:
                        json_format:
                          time: "%START_TIME%"
                          client: "%DOWNSTREAM_REMOTE_ADDRESS_WITHOUT_PORT%"
                          method: "%REQ(:METHOD)%"
                          path: "%REQ(:PATH)%"
                          status: "%RESPONSE_CODE%"
                          bytes: "%BYTES_SENT%"
                          duration_ms: "%DURATION%"
                          flags: "%RESPONSE_FLAGS%"

  clusters:
    - name: kubo_gateway
      type: STATIC
      connect_timeout: 2s
      load_assignment:
        cluster_name: kubo_gateway
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: { address: 127.0.0.1, port_value: {{ content_gateway_kubo_port }} }
