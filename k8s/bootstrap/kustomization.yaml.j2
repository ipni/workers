---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# One namespace per bootstrapper instance (bootstrap_instances): each holds the
# same objects, with the instance's ports from bootstrap_instance_table.
namespace: {{ bootstrap_namespace }}

resources:
  - namespace.yaml
  - pvc.yaml
  - deployment.yaml

labels:
  - pairs:
      app.kubernetes.io/name: bootstrap
      app.kubernetes.io/part-of: ipfs-workers

# Pinned by digest in roles/bootstrap/defaults/main.yml
# (bootstrap_default_kubo_image). An instance can run its own (kubo_image in
# its bootstrap_extra_instances entry): that is how one instance runs a canary
# while the others stay on the release.
images:
  - name: kubo
    newName: {{ bootstrap_kubo_image.name }}
    digest: {{ bootstrap_kubo_image.digest }}

# The kubo config Secret (kubo-config) is deliberately NOT here: it holds the
# node's private key and is created by roles/bootstrap from ansible-vault.
