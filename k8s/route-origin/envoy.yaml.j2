# Envoy as the Cloudflare origin for route-<box>.ipni.io.
#
# Cloudflare (Full strict) -> :443 TLS here -> 127.0.0.1:8190 (someguy).
# Both Envoy and someguy use hostNetwork, so the upstream is plain loopback.

admin:
  # Host loopback only (hostNetwork). ufw would block it anyway; this keeps the
  # admin API off every external interface regardless of firewall state.
  address:
    socket_address: { address: 127.0.0.1, port_value: 9901 }

# Cap concurrent downstream connections so a surge cannot grow Envoy's memory
# without bound (it warns at startup when no cap is set). Only Cloudflare can
# connect, and it pools connections to an origin, so real use should be far
# below this.
overload_manager:
  resource_monitors:
    - name: envoy.resource_monitors.global_downstream_max_connections
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.resource_monitors.downstream_connections.v3.DownstreamConnectionsConfig
        max_active_downstream_connections: 20000

static_resources:
  listeners:
    - name: https
      # Dual stack, as two sockets rather than one v4-mapped one: a v4-mapped
      # listener would hand every filter and access log a ::ffff:a.b.c.d peer
      # address, changing what the v4 path - the one carrying all the traffic
      # today - reports. additional_addresses keeps v4 byte-for-byte as it was
      # and adds v6 beside it. The v6 socket is v6-only (Envoy's default for a
      # :: address), so the two do not collide.
      #
      # ufw already allows Cloudflare's v6 ranges on 443. Until then nothing
      # answered on v6, so the allowlist described a door that was not there.
      address:
        socket_address: { address: 0.0.0.0, port_value: 443 }
      additional_addresses:
        - address:
            socket_address: { address: "::", port_value: 443 }
      filter_chains:
        - transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                alpn_protocols: ["h2", "http/1.1"]
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                tls_certificates:
                  # Cloudflare Origin CA certificate + locally generated key,
                  # mounted from the route-origin-tls secret. Read at startup;
                  # the Ansible role restarts Envoy when the secret changes.
                  - certificate_chain: { filename: /etc/envoy/tls/tls.crt }
                    private_key: { filename: /etc/envoy/tls/tls.key }
          filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: route_origin
                codec_type: AUTO
                # Edge proxy: the peer is a Cloudflare edge, so X-Forwarded-For
                # is set from it rather than trusted. The real client address
                # arrives in CF-Connecting-IP and is logged below.
                use_remote_address: true
                # Canonicalize the path BEFORE route matching. Without this the
                # "/routing/v1/" prefix also matched /routing/v1/../debug/... and
                # forwarded it unchanged; /debug stayed hidden only because
                # someguy's router happens to redirect unclean paths. The
                # allowlist must not depend on an upstream implementation detail.
                normalize_path: true
                merge_slashes: true
                path_with_escaped_slashes_action: REJECT_REQUEST
                request_headers_timeout: 10s
                # someguy keeps a response open for up to 25s
                # (SOMEGUY_ROUTING_TIMEOUT) while lookups run, and NDJSON
                # streams can be silent between records for most of that.
                stream_idle_timeout: 60s
                common_http_protocol_options:
                  idle_timeout: 300s
                  headers_with_underscores_action: REJECT_REQUEST
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                      log_format:
                        json_format:
                          time: "%START_TIME%"
                          client: "%REQ(CF-CONNECTING-IP)%"
                          cf_ray: "%REQ(CF-RAY)%"
                          method: "%REQ(:METHOD)%"
                          path: "%REQ(X-ENVOY-ORIGINAL-PATH?:PATH)%"
                          status: "%RESPONSE_CODE%"
                          flags: "%RESPONSE_FLAGS%"
                          bytes: "%BYTES_SENT%"
                          duration_ms: "%DURATION%"
                          upstream_ms: "%RESP(X-ENVOY-UPSTREAM-SERVICE-TIME)%"
                          # Which someguy instance served it. With four behind
                          # the round robin, a slow tail is only actionable if
                          # it can be attributed to one of them - a cold
                          # instance after a rollout looks exactly like a slow
                          # box until you can group by this.
                          upstream: "%UPSTREAM_HOST%"
                http_filters:
                  # Per-box backstop behind Cloudflare's own rate limiting rule.
                  # No bucket is configured here: it only acts on routes that
                  # carry a typed_per_filter_config below. Rejected requests get
                  # 429 and an x-local-rate-limit header.
                  - name: envoy.filters.http.local_ratelimit
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
                      stat_prefix: route_origin_ratelimit
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                route_config:
                  name: route
                  virtual_hosts:
                    - name: route
                      # Only our own hostnames. Reaching :443 from a Cloudflare
                      # IP proves nothing about which zone the request came
                      # through: ANY Cloudflare account can proxy its own
                      # hostname to these IPs (with SSL "Full", which skips cert
                      # validation). Anything else falls through to the 421
                      # virtual host below. This stops casual misuse only; a
                      # zone that rewrites Host can still get past it, which is
                      # what Authenticated Origin Pulls addresses.
                      #
                      # Add the live Cloudflare router's hostname here if it
                      # forwards a different Host.
                      domains:
                        - route-sing-1.ipni.io
                        - route-lith-1.ipni.io
                        - route-chic-1.ipni.io
                      # ALLOWLIST, not a blocklist. someguy serves Prometheus
                      # metrics on the same port as the API (/debug/...);
                      # anything not listed here - including endpoints a future
                      # someguy release adds - is never exposed publicly.
                      routes:
                        # IPNS publishing is deliberately open, matching the
                        # production delegated-ipfs.dev: records are
                        # self-certifying, but each PUT fans out to the DHT, so
                        # it gets a much smaller bucket than lookups.
                        - match:
                            prefix: "/routing/v1/ipns/"
                            headers:
                              - name: ":method"
                                string_match: { exact: "PUT" }
                          route:
                            cluster: someguy
                            timeout: 60s
                          typed_per_filter_config:
                            envoy.filters.http.local_ratelimit:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
                              stat_prefix: ipns_put
                              token_bucket: { max_tokens: 50, tokens_per_fill: 20, fill_interval: 1s }
                              filter_enabled:
                                runtime_key: ipns_put_ratelimit_enabled
                                default_value: { numerator: 100, denominator: HUNDRED }
                              filter_enforced:
                                runtime_key: ipns_put_ratelimit_enforced
                                default_value: { numerator: 100, denominator: HUNDRED }
                              response_headers_to_add:
                                - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                  header: { key: x-local-rate-limit, value: "ipns-put" }
                        # Lookups. A miss can hold a request for up to 25s while
                        # someguy queries the DHT and cid.contact. The bucket is a
                        # per-box ceiling, not a per-client limit (that is
                        # Cloudflare's job).
                        #
                        # 1000/s is now a MEASURED value, chosen where quality
                        # stops being acceptable rather than where the box stops
                        # answering (2026-09-16, four instances per box): at
                        # 1000 req/s p50 is already 2432ms on chic-1, 3044ms on
                        # sing-1 and 4078ms on lith-1, with p95 pinned at the
                        # DHT client's 5s timeoutPerOp. chic-1 will serve 1111
                        # req/s if allowed, but no faster and no better.
                        #
                        # For scale: 1.1B requests/month is ~424 req/s across
                        # the fleet, so one box at this limit absorbs ~2.4x the
                        # WHOLE fleet's average, or ~2.4-3.5x a single box's
                        # projected peak. It also survives losing a box: the two
                        # survivors would see ~630 req/s at peak, still under.
                        # Re-measure if geo-routing concentrates a region on one
                        # box (see README, "Capacity").
                        - match: { prefix: "/routing/v1/" }
                          route:
                            cluster: someguy
                            # Above the 25s routing timeout, below Cloudflare's
                            # 100s proxy read timeout.
                            timeout: 60s
                          typed_per_filter_config:
                            envoy.filters.http.local_ratelimit:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
                              stat_prefix: lookups
                              token_bucket: { max_tokens: 2000, tokens_per_fill: 1000, fill_interval: 1s }
                              filter_enabled:
                                runtime_key: lookups_ratelimit_enabled
                                default_value: { numerator: 100, denominator: HUNDRED }
                              filter_enforced:
                                runtime_key: lookups_ratelimit_enforced
                                default_value: { numerator: 100, denominator: HUNDRED }
                              response_headers_to_add:
                                - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                  header: { key: x-local-rate-limit, value: "lookups" }
                        - match: { path: "/version" }
                          route:
                            cluster: someguy
                            timeout: 5s
                        - match: { prefix: "/" }
                          direct_response:
                            status: 404
                            body: { inline_string: "not found\n" }

                    # Every other Host. 421 Misdirected Request tells a
                    # misconfigured caller exactly what is wrong.
                    - name: misdirected
                      domains: ["*"]
                      routes:
                        - match: { prefix: "/" }
                          direct_response:
                            status: 421
                            body: { inline_string: "misdirected request\n" }

  clusters:
    - name: someguy
      type: STATIC
      connect_timeout: 2s
      # Envoy's default of 1024 concurrent requests is too low when each lookup
      # can hold a request for 25s. 20000 matches the downstream connection cap
      # above, and stays well under the ~64k source ports a single loopback
      # upstream can use (the previous 100000 could never have been reached).
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_connections: 20000
            max_pending_requests: 20000
            max_requests: 20000
      # Four someguy instances per box (k8s/someguy). Round robin across them:
      # each is a separate process with its own PeerID and concurrency budget,
      # and requests queue behind slow DHT rounds per process, so spreading
      # them is what raised sing-1 from 355 to 894 req/s (README, "Capacity").
      lb_policy: ROUND_ROBIN

      # An instance that stops answering must be taken out of rotation, not
      # sent traffic that then fails: roles/someguy restarts them one at a time.
      # An ACTIVE health check is what does that here - passive outlier
      # detection alone cannot, because with four endpoints the default
      # max_ejection_percent of 10% never reaches one whole endpoint.
      #
      # During a rollout the instance being restarted refuses connections
      # outright, so the check fails immediately rather than by timeout, and it
      # is out of rotation within unhealthy_threshold x interval = 10s.
      #
      # The 2s timeout is safe because /version is a trivial handler that
      # touches neither the DHT nor the address book: lookup p50 runs to
      # seconds under load, but /version does not. WATCH THIS if someguy ever
      # grows a real health endpoint that does work, or if health-check
      # failures start appearing in the Envoy logs at peak - an instance that
      # flaps out for 5-10s sheds its share onto the other three and makes the
      # peak worse, which is the opposite of what this is for.
      health_checks:
        - timeout: 2s
          interval: 5s
          unhealthy_threshold: 2
          healthy_threshold: 1
          http_health_check: { path: /version }

      # Belt and braces behind the active check, for an instance that answers
      # /version while failing real requests. Bounded on purpose: all four
      # instances face the same upstreams, so a cid.contact outage would make
      # them fail together, and max_ejection_percent caps that at two. Envoy's
      # panic threshold (50% healthy by default) then routes to every endpoint
      # anyway rather than piling the whole box onto two, which is the right
      # answer when the failure is upstream rather than local.
      outlier_detection:
        consecutive_5xx: 3
        consecutive_gateway_failure: 3
        enforcing_consecutive_gateway_failure: 100
        interval: 5s
        base_ejection_time: 10s
        max_ejection_percent: 50
      # Rendered from someguy_running_instances (roles/someguy/defaults) by
      # roles/kustomize_apply, so lowering someguy_instances trims this list
      # too. It used to be written out by hand, which meant a lowered count
      # left Envoy health-checking ports that no longer existed and logging
      # the failures forever.
      load_assignment:
        cluster_name: someguy
        endpoints:
          - lb_endpoints:
{% for instance in someguy_running_instances %}
              # {{ instance.name }}
              - endpoint:
                  address:
                    socket_address: { address: 127.0.0.1, port_value: {{ instance.api }} }
{% endfor %}
