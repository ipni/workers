# Plaintext credentials — never commit
servers.txt
*.plaintext
.vault_pass
*.vault_pass

# Encrypted credentials are not committed either: the repository is public.
# They live only in the operators' secret store (see "Secrets" in README.md).
vault.yml

# Fetched kubeconfigs contain cluster admin credentials
kubeconfigs/
*.kubeconfig

# Personal Claude Code settings (and the writer's transient temp files).
# settings.json is ignored too: this repository is public, and the allowlist in
# it is one operator's convenience, not part of the deliverable.
.claude/settings.json
.claude/settings.local.json*

# Manifests rendered by scripts/render-manifests.yml for inspection or CI
/rendered/
/rendered-*/

# Ansible runtime artifacts
*.retry
.ansible/
facts_cache/

# Local working notes — reviews and task scratch, not part of the deliverable.
# Anchored with a leading slash: an unanchored "tasks/" would also swallow
# every role's roles/<role>/tasks/ directory.
/reviews/
/tasks/
/scripts/wss-check/node_modules/
