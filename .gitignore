# Plaintext credentials — never commit
servers.txt
secrets.txt
*.plaintext
.vault_pass
*.vault_pass
# Private keys of the legacy bootstrap.libp2p.io identities; read only by
# scripts/import-bootstrap-identities.py.
bootstrap-keys.txt

# Encrypted credentials are not committed either: the repository is public.
# They live only in the operators' secret store (see "Secrets" in README.md).
vault.yml

# Fetched kubeconfigs contain cluster admin credentials
kubeconfigs/
*.kubeconfig

# Manifests rendered by scripts/render-manifests.yml for inspection or CI
/rendered/
/rendered-*/

# Ansible runtime artifacts
*.retry
.ansible/
facts_cache/

# Fetched by scripts/wss-check; not part of the deliverable.
/scripts/wss-check/node_modules/

# Personal working files - scratch notes, review write-ups, editor and agent
# settings - are deliberately absent from this list. They are one operator's
# workflow, not the repository's, and this repository is public. Ignore them
# per clone in .git/info/exclude instead of adding them here.
