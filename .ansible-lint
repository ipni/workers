---
# Style rules that fire across the whole repo without pointing at a real
# problem. Everything else is left on: the point of running this in CI is to
# catch the mistakes, not to relitigate the house style.
exclude_paths:
  - .github/
  - facts_cache/
  - kubeconfigs/
  # The leading slash anchors these to the repo-root directories of those
  # names, so a same-named directory inside a role - `roles/*/tasks/` - is not
  # excluded with them.
  - /reviews/
  - /tasks/
  - scripts/wss-check/node_modules/
  # Gitignored encrypted credentials; only the operators' machines have them.
  - vault.yml

skip_list:
  # Long lines are mostly kubectl/ipfs-cluster-ctl argv lists, which are
  # clearer on one line than folded.
  - yaml[line-length]
  # `{{ x }}` spacing inside inline flow mappings, e.g. the pinset fixtures.
  - yaml[braces]
  # Role variables here are named for what they configure (admin_user,
  # ssh_port, data_mount) and are shared across roles by design, so the
  # role-name prefix rule works against how the group_vars are laid out.
  - var-naming[no-role-prefix]
  # Task names are written as sentences ("Fail unless ..."), which reads
  # better in output than the enforced casing.
  - name[casing]
  # ...and as sentences with templates in them ("Ship the {{ kustomize_app }}
  # kustomization"), which reads better than pushing the templates to the end.
  - name[template]
  # No play sets `strategy: free`, so the behaviour the rule warns about does
  # not occur; the tasks (fleet-wide waits, the upgrade gate) run once on purpose.
  - run-once
  # The restart-wait and reload tasks are sequenced on purpose: the play's
  # verification depends on them having completed, and a handler - notified,
  # then run at the end of the play - would run after the verification.
  - no-handler
